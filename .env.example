# ==============================================================================
# Wavelet ♫ 发烧级母带音乐播放引擎 - 环境变量配置模板
# ==============================================================================
# 将此文件复制为 .env 并在其中配置您的个性化参数：
#   cp .env.example .env
#
# Wavelet 启动时将自动按以下优先级检测并载入：
#   1. CLI 指定参数 (--env-file <path> 或 $WAVELET_ENV_FILE)
#   2. 当前执行目录 ($PWD/.env)
#   3. Wavelet 工程根目录 ($PROJECT_ROOT/.env)
#   4. 用户全局配置目录 (~/.config/wavelet/.env 或 ~/.wavelet/.env)
# ==============================================================================

# 运行环境 (production | development)
NODE_ENV=production

# 网关监听网络地址 (默认 127.0.0.1 仅本地受保护回路，0.0.0.0 允许局域网设备接入)
HOST=127.0.0.1
PORT=23333

# 自定义配置文件路径 (若留空则默认读取 ~/.wavelet/config.json)
# WAVELET_CONFIG_PATH=~/.wavelet/config.json

# 本地母带曲库绝对路径 (用于音频扫描与持久化索引)
# WAVELET_LIBRARY_DIR=~/Music/Wavelet_Library

# 系统日志输出级别 (debug | info | warn | error)
WAVELET_LOG_LEVEL=info

# 自定义日志存储目录
# WAVELET_LOG_DIR=~/.wavelet/logs

# 自定义 PID 文件存储位置
# WAVELET_PID_FILE=~/.wavelet/wavelet.pid

# 音频转码与体检最大并行工作线程数 (默认自动匹配 CPU 核心数)
# WAVELET_MAX_CONCURRENCY=8
